# ── MSSQL source (Azure SQL) ─────────────────────────────────────────────────
MS_HOST=myserver.database.windows.net
MS_PORT=1433
MS_DATABASE=mydb
MS_USER=sa
MS_PASSWORD=secret
# TDS version: 7.4 for Azure SQL, 7.3 for older SQL Server
MS_TDS=7.4

# ── PostgreSQL target (Azure Flexible Server) ────────────────────────────────
PG_HOST=mypg.postgres.database.azure.com
PG_PORT=5432
PG_DATABASE=mydb
PG_USER=pgadmin
PG_PASSWORD=secret
# require | verify-ca | verify-full | disable
PG_SSLMODE=require
